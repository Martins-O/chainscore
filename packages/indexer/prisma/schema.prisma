generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IndexerState {
  id        String @id
  lastBlock Int    @default(0)
}

model WalletHistory {
  id                        String        @id
  firstTxTimestamp          BigInt
  txCount                   Int           @default(0)
  loanCount                 Int           @default(0)
  repaymentCount            Int           @default(0)
  defaultCount              Int           @default(0)
  tokenBalances             Json          @default("[]")
  dailyTxCounts             DailyTxCount[]
  transferCountBetweenLinked Int          @default(0)
  totalTransfers            Int           @default(0)
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
}

model DailyTxCount {
  id        String        @id @default(cuid())
  date      String
  count     Int           @default(0)
  walletId  String
  wallet    WalletHistory @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, date])
}

model LoanEvent {
  id              String  @id @default(cuid())
  loanId          BigInt
  agentId         BigInt
  type            String
  amount          BigInt
  collateral      BigInt?
  collateralToken String?
  timestamp       BigInt
  txHash          String
  blockNumber     Int

  @@index([loanId])
  @@index([agentId])
}
